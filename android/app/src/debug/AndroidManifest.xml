<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: measure the phone's own voice from adb (docs/phone.md). DUMP is held by adb's shell,
     not by apps, so nothing else on the phone can trigger it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.Bench"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
