<?xml version="1.0" encoding="utf-8"?>
<!-- Phone control (HandsService): reads the windows on demand, acts on nodes and by gestures. The service
     ignores the events, but Android only refreshes its cached copy of the screen on the events a service
     takes: without content and scroll events a read after a scroll returns the old screen. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged|typeViewScrolled|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagReportViewIds|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/hands_about"
    android:notificationTimeout="200" />
