[Unit]
Description=Auren voice assistant (ears, brain, hands, voice)
After=graphical-session.target wayland-session-waitenv.service pipewire.service
PartOf=graphical-session.target
# No ConditionEnvironment=WAYLAND_DISPLAY: systemd checks a condition once, so a display that arrives
# late at login would keep Auren off until the next login. The daemon waits for it itself
# (src/auren/display.py): 75 means "start again", 78 "there's no display, stop".

[Service]
@ENV@
ExecStart=@AUREN@ daemon
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=78

[Install]
WantedBy=graphical-session.target
