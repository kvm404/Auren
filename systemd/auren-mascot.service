[Unit]
Description=Auren mascot (floating character that shows what Auren is doing)
After=wayland-session-waitenv.service
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
@ENV@
ExecStart=@QS@ -n -p @SHARE@/mascot
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
