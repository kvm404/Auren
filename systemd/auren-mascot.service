[Unit]
Description=Auren mascot (floating character that shows what Auren is doing)
After=graphical-session.target wayland-session-waitenv.service
PartOf=graphical-session.target
# Waits for the session's display the way auren.service does (see there).

[Service]
@ENV@
ExecStart=@AUREN@ with-display @QS@ -n -p @MASCOT@
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=78

[Install]
WantedBy=graphical-session.target
