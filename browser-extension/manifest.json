{
  "manifest_version": 3,
  "name": "Auren Tabs",
  "version": "0.1.0",
  "description": "Let Auren list and switch existing browser tabs without typing into pages.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
