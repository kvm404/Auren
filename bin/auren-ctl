#!/bin/sh
# For key bindings made before Auren was installed to ~/.local/share/auren: runs the installed
# auren-ctl (or the checkout's own environment).
for ctl in "${XDG_DATA_HOME:-$HOME/.local/share}/auren/bin/auren-ctl" "$(dirname "$0")/../.venv/bin/auren-ctl"; do
  [ -x "$ctl" ] && exec "$ctl" "$@"
done
echo "auren-ctl isn't installed: run ./install.sh" >&2
exit 1
